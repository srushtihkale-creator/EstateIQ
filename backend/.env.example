# ==============================================================================
# EstateIQ Backend — Local Environment Configuration Template (backend/.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to backend/.env:
#    cp backend/.env.example backend/.env
# 2. Enter your real local PostgreSQL credentials in backend/.env.
# 3. NEVER commit backend/.env to Git or disclose credentials in chat.
# 4. Use fake placeholders only in this template file.
# ==============================================================================

# Application Environment ('development', 'staging', 'production')
ENVIRONMENT=development
DEBUG=false

# ------------------------------------------------------------------------------
# Local PostgreSQL Configuration (Two Options - Choose One)
# ------------------------------------------------------------------------------

# OPTION 1: Full Database URL
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]
DATABASE_URL=postgresql://postgres:your_local_password@localhost:5432/estateiq_db

# OPTION 2: Discrete PostgreSQL Parameters (Used if DATABASE_URL is not set)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_local_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=estateiq_db

# ------------------------------------------------------------------------------
# Security, Authentication & Session Configuration
# ------------------------------------------------------------------------------

# Session Secret (High-entropy random key for cryptographic signing)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-with-a-secure-random-secret-key-min-32-chars

# Session Cookie Configuration
SESSION_COOKIE_NAME=estateiq_session
SESSION_EXPIRE_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CSRF Protection
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_COOKIE_NAME=estateiq_csrf

# Allowed CORS Origins (JSON list)
FRONTEND_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Rate Limiting (Requests per minute per client IP)
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=120

# Model Pipeline Artifact Paths
MODEL_ARTIFACT_PATH=ml/inference/artifacts/estateiq_model_pipeline.joblib
MODEL_METADATA_PATH=ml/inference/artifacts/model_metadata.json
